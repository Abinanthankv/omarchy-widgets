  let castleArt = {o: [[[6, 0], [7, 0], [7, 1], [10, 1], [10, 2], [11, 2], [11, 3], [7, 3], [7, 4], [8, 4], [8, 6], [9, 6], [9, 5], [10, 5], [10, 4], [12, 4], [12, 20], [0, 20], [0, 4], [2, 4], [2, 5], [3, 5], [3, 6], [4, 6], [4, 4], [6, 4]]], r: [[1, 7, 10, 9, "S"], [1, 16, 2, 3, "S"], [5, 5, 2, 2, "S"], [1, 5, 1, 2, "S"], [10, 5, 1, 2, "S"], [9, 16, 2, 2, "S"], [10, 7, 1, 12, "s"], [3, 9, 1, 1, "s"], [8, 9, 1, 1, "s"], [2, 11, 1, 1, "s"], [3, 13, 1, 1, "s"], [8, 13, 1, 1, "s"], [1, 15, 1, 1, "s"], [4, 15, 1, 1, "s"], [2, 17, 1, 1, "s"], [9, 11, 2, 1, "s"], [9, 15, 2, 1, "s"], [9, 18, 2, 1, "s"], [4, 11, 4, 2, "K"], [4, 17, 4, 2, "K"], [5, 10, 2, 1, "K"], [1, 8, 10, 1, "y"], [7, 1, 2, 2, "F"], [9, 2, 1, 1, "F"]]}
  let treeArt = {o: [[[4, 0], [8, 0], [8, 1], [9, 1], [9, 2], [10, 2], [10, 3], [11, 3], [11, 5], [12, 5], [12, 8], [11, 8], [11, 9], [10, 9], [10, 10], [8, 10], [8, 13], [9, 13], [9, 14], [3, 14], [3, 13], [4, 13], [4, 10], [2, 10], [2, 9], [1, 9], [1, 8], [0, 8], [0, 5], [1, 5], [1, 3], [2, 3], [2, 2], [3, 2], [3, 1], [4, 1]]], r: [[2, 3, 8, 6, "I"], [5, 2, 4, 1, "I"], [1, 6, 10, 2, "I"], [7, 1, 1, 1, "I"], [9, 5, 2, 3, "i"], [4, 9, 4, 1, "i"], [7, 8, 3, 1, "i"], [8, 3, 1, 1, "i"], [9, 4, 1, 1, "i"], [5, 6, 1, 1, "i"], [4, 8, 1, 1, "i"], [8, 7, 3, 1, "i"], [4, 1, 3, 1, "j"], [3, 2, 2, 1, "j"], [2, 3, 1, 1, "j"], [1, 5, 1, 1, "j"], [5, 10, 2, 4, "T"], [6, 10, 1, 4, "t"]]}
  let rockArt = {o: [[[3, 0], [7, 0], [7, 1], [8, 1], [8, 2], [9, 2], [9, 3], [10, 3], [10, 5], [9, 5], [9, 6], [8, 6], [8, 7], [2, 7], [2, 6], [1, 6], [1, 5], [0, 5], [0, 3], [1, 3], [1, 2], [2, 2], [2, 1], [3, 1]]], r: [[3, 1, 4, 4, "S"], [1, 3, 8, 2, "S"], [2, 2, 6, 1, "S"], [6, 2, 2, 3, "s"], [6, 1, 1, 1, "s"], [8, 3, 1, 1, "s"], [1, 4, 1, 1, "s"], [5, 4, 4, 1, "s"], [2, 5, 6, 1, "d"], [8, 4, 1, 1, "d"], [3, 2, 1, 1, "Z"]]}
  let coinArt = {o: [[[1, 0], [6, 0], [6, 1], [7, 1], [7, 6], [6, 6], [6, 7], [1, 7], [1, 6], [0, 6], [0, 1], [1, 1]]], r: [[1, 1, 5, 4, "Y"], [5, 1, 1, 5, "y"], [1, 5, 5, 1, "y"], [4, 4, 2, 1, "y"], [2, 2, 1, 1, "Z"]]}
  let heartArt = {o: [[[1, 0], [3, 0], [3, 1], [4, 1], [4, 0], [6, 0], [6, 1], [7, 1], [7, 3], [6, 3], [6, 4], [5, 4], [5, 5], [4, 5], [4, 6], [3, 6], [3, 5], [2, 5], [2, 4], [1, 4], [1, 3], [0, 3], [0, 1], [1, 1]]], r: [[2, 2, 3, 2, "E"], [4, 1, 2, 1, "E"], [1, 1, 2, 2, "E"], [5, 2, 1, 1, "e"], [4, 3, 1, 1, "e"], [3, 4, 1, 1, "e"], [1, 1, 1, 1, "Z"]]}
  let towerArt = [archerArt, cannonArt, frostArt, teslaArt]
  let enemyArt = [[slime0Art, slime1Art], [bat0Art, bat1Art], [knight0Art, knight1Art], [ogre0Art, ogre1Art]]
  // art size, and how big an art pixel is against a tower's
  let enemySize = [[10, 9], [12, 8], [10, 12], [16, 16]]
  let enemyScale = [0.8, 0.8, 0.85, 1.05]
  // the roofs and trims of towers as they level up: bronze, silver, gold, obsidian, sun
  let TIERS = [
    {R: "#d24a3c", r: "#962f2f", Y: "#e8c06a", y: "#a8803a"},
    {R: "#4a7ad8", r: "#2f4f9a", Y: "#e4e8f0", y: "#9aa0b4"},
    {R: "#9a4ad8", r: "#62309a", Y: "#ffd34e", y: "#d0902a"},
    {R: "#33334a", r: "#1c1c2a", Y: "#7ff0ff", y: "#3fb6e6"},
    {R: "#ffd34e", r: "#d0902a", Y: "#ffffff", y: "#ffe9a0"}
  ]
  let tierPal = TIERS.map(t => merge(PAL, t))
  let tierGlow = ["#e8c06a", "#c8d8ff", "#ffd34e", "#7ff0ff", "#fff4b0"]
  let flowerColor = ["#f4f0ff", "#ff9ad0", "#9ad0ff"]

  Canvas {
    fill: true
    background: background

    onTap: {
      if mode == "title" || (mode == "over" && (time - overT > 1.2 || time < overT)) {
        towers = []
        base = {t: 0, es: [], cd: [], sh: [], dd: [], lk: [], gold: 200, lives: 20, nid: 0}
        grows = FIT
        wave = 0
        nextAt = 20
        sel = -1
        ev = time
        msg = "BUILD YOUR DEFENSES"
        msgT = time
        mode = "play"
      } else if mode == "play" {
        let hu = clamp((time - ev) * speed / DT, 0, NS)
        let hj = floor(hu)
        let hS = film[hj]
        let hcx = floor(((LS ? y - FY : x - FX)) / C)
        let hcy = floor(((LS ? x - FX : y - FY)) / C)
        let hcell = hcy * COLS + hcx
        let hti = indexOf(towers.map(t => t.c), sel)
        if y < FY - 2 && x >= SW - 106 {
          // send the next wave now, with a bonus for the time left
          base = merge(hS, {gold: hS.gold + (nextAt > 0 ? 2 * ceil(max(0, nextAt - hS.t)) : 0)})
          nextAt = hS.t + 0.001
          ev = time - (hu - hj) * DT / speed
          haptic()
        } else if y < FY - 2 && x >= SW - 158 {
          base = hS
          speed = 3 - speed
          ev = time - (hu - hj) * DT / speed
        } else if hcx >= 0 && hcx < COLS && hcy >= 0 && hcy < ROWS && x >= FX && y >= FY {
          sel = sel == hcell ? -1 : indexOf(towers.map(t => t.c), hcell) >= 0 || indexOf(blocked, hcell) < 0 ? hcell : -1
        } else if x >= PX && y >= PY && sel >= 0 && hti < 0 {
          let hk = floor((x - PX - 8) / (CWd + 6)) + CC * floor((y - CY) / (CH + 6))
          if x >= PX + 8 && floor((x - PX - 8) / (CWd + 6)) < CC && y >= CY && hk >= 0 && hk < 4 && hS.gold >= KD[hk].cost {
            base = merge(hS, {gold: hS.gold - KD[hk].cost, cd: hS.cd + [0]})
            towers = towers + [{c: sel, k: hk, l: 1, sp: KD[hk].cost}]
            ev = time - (hu - hj) * DT / speed
            haptic()
          }
        } else if x >= PX && y >= PY && hti >= 0 && x >= BX {
          let ht = towers[hti]
          let hcost = tw[hti].up
          if y >= UY && y < UY + BH && hS.gold >= hcost {
            base = merge(hS, {gold: hS.gold - hcost})
            towers = set(towers, hti, merge(ht, {l: ht.l + 1, sp: ht.sp + hcost}))
            ev = time - (hu - hj) * DT / speed
            haptic()
          } else if y >= SY && y < SY + BH {
            base = merge(hS, {gold: hS.gold + tw[hti].sell, cd: remove(hS.cd, hti)})
            towers = remove(towers, hti)
            sel = -1
            ev = time - (hu - hj) * DT / speed
          }
        } else if x >= PX && y >= PY {
          sel = -1
        }
      }
    }

    // ---- where the battle is ----
    // u is the step the clock is in; F1 is the step being walked into, F0 the one just left.
    let playing = mode == "play"
    let u = playing ? clamp((time - ev) * speed / DT, 0, NS - 0.001) : 0
    let a = floor(u)
    let fr = playing ? u - a : 1
    let F0 = film[a]
    let F1 = playing ? film[a + 1] : film[0]
    let Fm = playing && a > 0 ? film[a - 1] : {dd: [], lk: []}
    let q = C / 12
    let gold = F0.gold
    let lives = max(0, F0.lives)
    let selT = indexOf(towers.map(t => t.c), sel)

    // ---- the ground ----
    clip(FX, FY, FW, FHt) {
      rect(FX, FY, FW, FHt, fill: "#5a9e45")
      translate(FX, FY) {
        // on its side in landscape: turned a quarter and mirrored, x and y swap
        scale(LS ? -q : q, q, 0, 0) {
          rotate(LS ? 90 : 0, 0, 0) {
          for t in tufts {
            if t[2] == 0 {
              rect(t[0], t[1] + 1, 3, 1, fill: "#4a8a3a")
              rect(t[0] + 1, t[1], 1, 1, fill: "#77bf58")
            } else {
              rect(t[0], t[1] + 1, 3, 1, fill: flowerColor[t[2] - 1])
              rect(t[0] + 1, t[1], 1, 3, fill: flowerColor[t[2] - 1])
              rect(t[0] + 1, t[1] + 1, 1, 1, fill: "#ffd34e")
            }
          }
          // the road: a dark verge, then the dirt
          for g in segs { rect(min(g.ax, g.bx) * 12, min(g.ay, g.by) * 12, abs(g.bx - g.ax) * 12 + 12, abs(g.by - g.ay) * 12 + 12, fill: "#4c8a3c") }
          for g in segs { rect(min(g.ax, g.bx) * 12 + 1, min(g.ay, g.by) * 12 + 1, abs(g.bx - g.ax) * 12 + 10, abs(g.by - g.ay) * 12 + 10, fill: "#8a6a44") }
          for g in segs { rect(min(g.ax, g.bx) * 12 + 2, min(g.ay, g.by) * 12 + 2, abs(g.bx - g.ax) * 12 + 8, abs(g.by - g.ay) * 12 + 8, fill: "#c9a46c") }
          for p in pebbles { rect(p[0], p[1], 2, 1, fill: "#a8865a") }
          // the pond, with light on the water and a lily
          translate(0, (PR - 7) * 12) {
          rect(75, 85, 18, 22, fill: "#2f6f9a")
          rect(73, 87, 22, 18, fill: "#2f6f9a")
          rect(76, 86, 16, 20, fill: "#4aa3df")
          rect(74, 88, 20, 16, fill: "#4aa3df")
          rect(78, 91, 12, 10, fill: "#3a8fcc")
          for k in range(3) { rect(75 + (time * (2 + k) + k * 7) % 15, 89 + k * 5, 3, 1, fill: "#bfe8ff") }
          rect(85, 98, 4, 3, fill: "#3f8f3a")
          rect(86, 98, 1, 1, fill: "#ff9ad0")
          }
          }
        }
      }
      // the rift the monsters come out of
      let rx = LS ? FX : FX + 1.5 * C
      let ry = LS ? FY + 1.5 * C : FY
      for k in range(4) { circle(rx, ry, (0.62 - k * 0.14 + 0.03 * sin(time * 3 + k)) * C, fill: ["#2a1640", "#5a2a8a", "#9a5ae0", "#e8c8ff"][k]) }
      for k in range(6) {
        let ang = time * 2.2 + k * 1.047
        rect(rx + (LS ? abs(sin(ang)) * 0.4 : cos(ang) * 0.48) * C - q / 2, ry + (LS ? cos(ang) * 0.48 : abs(sin(ang)) * 0.4) * C - q / 2, q, q, fill: "#e8c8ff")
      }
    }
    // trees and rocks
    for p in trees {
      translate(FX + (LS ? p[1] : p[0]) * C, FY + (LS ? p[0] : p[1]) * C - 2 * q) {
        scale(q, q, 0, 0) {
          for o in treeArt.o { path(o, closed: true, fill: PAL.o) }
          for r in treeArt.r { rect(r[0], r[1], r[2], r[3], fill: PAL[r[4]]) }
        }
      }
    }
    for p in rocks {
      translate(FX + (LS ? p[1] : p[0]) * C + q, FY + (LS ? p[0] : p[1]) * C + 3 * q) {
        scale(q, q, 0, 0) {
          for o in rockArt.o { path(o, closed: true, fill: PAL.o) }
          for r in rockArt.r { rect(r[0], r[1], r[2], r[3], fill: PAL[r[4]]) }
        }
      }
    }
    // the keep at the end of the road, red when monsters get in
    translate(FX + (LS ? KY : 8) * C, FY + (LS ? 9 : KY + 1) * C - 20 * q) {
      scale(q, q, 0, 0) {
        for o in castleArt.o { path(o, closed: true, fill: PAL.o) }
        for r in castleArt.r { rect(r[0], r[1], r[2], r[3], fill: PAL[r[4]]) }
      }
    }
    if len(F0.lk) + len(Fm.lk) > 0 {
      rect(FX + (LS ? KY : 8) * C, FY + (LS ? 9 : KY + 1) * C - 20 * q, C, 20 * q, fill: alpha("#ff3030", 0.45 * (1 - fr)))
    }

    // the selected cell, and a tower's range
    if sel >= 0 && playing {
      let sx = FX + (LS ? floor(sel / COLS) : sel % COLS) * C
      let sy = FY + (LS ? sel % COLS : floor(sel / COLS)) * C
      if selT >= 0 {
        circle(sx + C / 2, sy + C / 2, tw[selT].r * C, fill: alpha("#ffffff", 0.1), stroke: alpha("#ffffff", 0.55), width: q)
      }
      rect(sx, sy, C, C, fill: alpha("#ffffff", 0.18 + 0.08 * sin(time * 5)), stroke: "#ffffff", width: q * 0.75)
    }

    // ---- towers, top row first ----
    for t in tw.sortBy(t => t.c) {
      let tier = min(4, floor((t.l - 1) / 3))
      let tx = FX + (LS ? t.y : t.x) * C
      let ty = FY + (LS ? t.x : t.y) * C - 4 * q
      if tier >= 2 {
        circle(tx + C / 2, ty + 9 * q, (6.5 + 0.6 * sin(time * 3 + t.c)) * q, fill: alpha(tierGlow[tier], 0.22))
      }
      translate(tx, ty) {
        scale(q, q, 0, 0) {
          for o in towerArt[t.k].o { path(o, closed: true, fill: PAL.o) }
          for r in towerArt[t.k].r { rect(r[0], r[1], r[2], r[3], fill: tierPal[tier][r[4]]) }
          if t.k == 3 { circle(6, 2, 2.6 + 0.6 * sin(time * 8 + t.c), fill: alpha("#e0c0ff", 0.35)) }
          if t.k == 2 { circle(6, 4, 3.5 + 0.5 * sin(time * 3 + t.c), fill: alpha("#bff6ff", 0.25)) }
          for i in range((t.l - 1) % 3 + 1) { rect(3.5 + i * 2 - ((t.l - 1) % 3) + 1.5, 16.6, 1.2, 1.2, fill: tierGlow[tier]) }
        }
      }
    }

    clip(FX, FY, FW, FHt) {
      // ---- monsters ----
      for e in F1.es + F1.dd + F1.lk {
        let lx = lerp(e.px, e.x, fr)
        let ly = lerp(e.py, e.y, fr)
        let ex = FX + ((LS ? ly : lx) + 0.5) * C
        let ey = FY + ((LS ? lx : ly) + 0.5) * C
        if ly > -1 {
          let s = enemyScale[e.k] * q
          let sz = enemySize[e.k]
          let fly = e.k == 1 ? (3 + sin(time * 7 + e.i) * 1.5) * q : 0
          let foot = ey + 0.22 * C
          rect(ex - sz[0] * s * 0.35, foot - q * 0.6, sz[0] * s * 0.7, q * 1.2, fill: alpha("#14301a", 0.35))
          translate(ex - sz[0] * s / 2, foot - fly - sz[1] * s) {
            scale(s, s, 0, 0) {
              for o in enemyArt[e.k][floor(time * (e.k == 1 ? 8 : 4) + e.i * 0.37) % 2].o { path(o, closed: true, fill: e.sl ? "#1e4a66" : PAL.o) }
              for r in enemyArt[e.k][floor(time * (e.k == 1 ? 8 : 4) + e.i * 0.37) % 2].r { rect(r[0], r[1], r[2], r[3], fill: e.sl && r[4] != "E" ? mix(PAL[r[4]], "#9fe8ff", 0.45) : PAL[r[4]]) }
            }
          }
          if e.ph < e.mh {
            let bw = sz[0] * s
            let by = foot - fly - sz[1] * s - 2.5 * q
            rect(ex - bw / 2 - q / 2, by - q / 2, bw + q, 2 * q, fill: "#1e1726")
            rect(ex - bw / 2, by, bw * clamp(e.ph / e.mh, 0, 1), q, fill: e.ph / e.mh > 0.5 ? "#6fe05a" : e.ph / e.mh > 0.25 ? "#ffd34e" : "#ff5a4a")
          }
        }
      }

      // ---- shots on their way ----
      for s in F1.sh {
        let sx = FX + ((LS ? s.ay : s.ax) + 0.5) * C
        let sy = FY + ((LS ? s.ax : s.ay) + 0.5) * C - 0.55 * C
        let bx = FX + ((LS ? s.by : s.bx) + 0.5) * C
        let by = FY + ((LS ? s.bx : s.by) + 0.5) * C
        let cx = lerp(sx, bx, fr)
        if s.k == 0 {
          let cy = lerp(sy, by, fr) - sin(fr * 3.14) * 0.25 * C
          let dl = max(1, sqrt(pow(bx - sx, 2) + pow(by - sy, 2)))
          line(cx - (bx - sx) / dl * 5 * q, cy - (by - sy) / dl * 5 * q, cx, cy, stroke: "#f4e6c8", width: q * 0.8)
          rect(cx - q * 0.6, cy - q * 0.6, q * 1.2, q * 1.2, fill: "#e0e4f0")
        } else if s.k == 1 {
          let cy = lerp(sy, by, fr) - sin(fr * 3.14) * 0.9 * C
          circle(cx, cy, 1.7 * q, fill: "#2a2a3a")
          rect(cx - 0.8 * q, cy - 0.9 * q, 0.7 * q, 0.7 * q, fill: "#9a9ab4")
        }
      }
      // ---- and landing ----
      for s in F0.sh {
        let sx = FX + ((LS ? s.ay : s.ax) + 0.5) * C
        let sy = FY + ((LS ? s.ax : s.ay) + 0.5) * C
        let bx = FX + ((LS ? s.by : s.bx) + 0.5) * C
        let by = FY + ((LS ? s.bx : s.by) + 0.5) * C
        if s.k == 0 && fr < 0.4 {
          for k in range(3) { rect(bx + cos(k * 2.1) * fr * 6 * q, by + sin(k * 2.1) * fr * 6 * q - 3 * q, q, q, fill: "#fff4c8") }
        } else if s.k == 1 {
          circle(bx, by, (0.3 + fr * s.sp) * C, fill: alpha("#ff8a30", 0.55 * (1 - fr)))
          circle(bx, by, (0.2 + fr * 0.35) * C, fill: alpha("#ffe9a0", 0.85 * (1 - fr)))
          for k in range(6) { rect(bx + cos(k * 1.05) * fr * s.sp * C, by + sin(k * 1.05) * fr * s.sp * C - sin(fr * 3.14) * 4 * q, 1.4 * q, 1.4 * q, fill: alpha("#5a3a22", 1 - fr)) }
        } else if s.k == 2 {
          circle(sx, sy, s.r * C * (0.25 + 0.75 * fr), fill: alpha("#aef4ff", 0.12 * (1 - fr)), stroke: alpha("#dffcff", 0.7 * (1 - fr)), width: 1.2 * q)
        } else if s.k == 3 && fr < 0.7 {
          let pts = [[sx, sy - 0.8 * C]] + s.p.map(p => [FX + ((LS ? p[1] : p[0]) + 0.5) * C, FY + ((LS ? p[0] : p[1]) + 0.5) * C - 0.2 * C])
          let zz = flatten(range(len(pts) - 1).map(i => [pts[i], [(pts[i][0] + pts[i + 1][0]) / 2 + (hash(i, floor(time * 24)) - 0.5) * 0.6 * C, (pts[i][1] + pts[i + 1][1]) / 2 + (hash(i, floor(time * 24), 1) - 0.5) * 0.6 * C]])) + [last(pts)]
          path(zz, stroke: alpha("#b583ff", 1 - fr), width: 2.6 * q, cap: round)
          path(zz, stroke: alpha("#ffffff", 1 - fr), width: q, cap: round)
          for p in pts.drop(1) { circle(p[0], p[1], 2.2 * q * (1 - fr), fill: alpha("#e9d5ff", 0.8)) }
        }
      }
      // ---- the fallen: a puff, and their gold rising ----
      for g in [[F0.dd, fr], [Fm.dd, 1 + fr]] {
        for d in g[0] {
          let ag = g[1] / 2
          let dx = FX + ((LS ? d.y : d.x) + 0.5) * C
          let dy = FY + ((LS ? d.x : d.y) + 0.5) * C
          for k in range(6) { rect(dx + cos(k * 1.05 + d.i) * ag * 0.6 * C - q, dy + sin(k * 1.05 + d.i) * ag * 0.6 * C - q, 2 * q * (1 - ag), 2 * q * (1 - ag), fill: alpha("#f0f0f0", 1 - ag)) }
          text("+${d.g}", dx + 1, dy - ag * 0.7 * C - 0.3 * C + 1, size: 7, color: alpha("#2a1838", 1 - ag), font: press, align: center)
          text("+${d.g}", dx, dy - ag * 0.7 * C - 0.3 * C, size: 7, color: alpha("#ffd34e", 1 - ag), font: press, align: center)
        }
      }
    }
    // a red edge when one gets in
    if len(F0.lk) > 0 {
      rect(FX, FY, FW, FHt, stroke: alpha("#ff3030", 0.6 * (1 - fr)), width: 3 * q)
    }

    // ---- the wave banner ----
    if playing && time - msgT < 2.2 {
      let mt = time - msgT
      let ma = min(1, mt * 4, (2.2 - mt) * 3)
      let my = FY + FHt * 0.42 - (1 - min(1, mt * 4)) * 10
      rect(FX, my - 18, FW, 36, fill: alpha(background, 0.7 * ma))
      text(msg, FX + FW / 2 + 2, my + 2, size: 14, color: alpha(background, ma), font: press, align: center)
      text(msg, FX + FW / 2, my, size: 14, color: alpha(accent, ma), font: press, align: center)
    }

    // ---- the top bar ----
    rect(0, 0, SW, FY - 4, fill: background)
    rect(0, FY - 4, SW, 2, fill: border)
    let hy = TOP + 20
    translate(14, hy - 7) { scale(2, 2, 0, 0) { for o in coinArt.o { path(o, closed: true, fill: PAL.o) }  for r in coinArt.r { rect(r[0], r[1], r[2], r[3], fill: PAL[r[4]]) } } }
    text(fmtNum(gold, {compact: gold >= 100000}), 34, hy + 1, size: 10, color: yellow, font: press)
    translate(100, hy - 6) { scale(2, 2, 0, 0) { for o in heartArt.o { path(o, closed: true, fill: PAL.o) }  for r in heartArt.r { rect(r[0], r[1], r[2], r[3], fill: PAL[r[4]]) } } }
    text("${lives}", 118, hy + 1, size: 10, color: red, font: press)
    text("WAVE", 154, hy - 6, size: 6, color: muted, font: press)
    text("${wave}", 154, hy + 6, size: 10, color: foreground, font: press)
    if playing {
      // speed
      rect(SW - 156, TOP + 6, 44, 28, fill: speed == 2 ? alpha(accent, 0.35) : surface)
      rect(SW - 156, TOP + 6, 44, 2, fill: alpha(foreground, 0.15))
      rect(SW - 156, TOP + 32, 44, 2, fill: alpha("#000000", 0.35))
      text(speed == 2 ? "x2" : "x1", SW - 134, TOP + 20, size: 9, color: foreground, font: press, align: center)
      // the next wave
      rect(SW - 106, TOP + 6, 92, 28, fill: nextAt > 0 ? green : orange)
      rect(SW - 106, TOP + 6, 92, 2, fill: alpha("#ffffff", 0.3))
      rect(SW - 106, TOP + 32, 92, 2, fill: alpha("#000000", 0.35))
      text(nextAt > 0 ? "GO ${max(0, ceil(nextAt - F0.t))}" : "+WAVE", SW - 60, TOP + 20, size: 9, color: background, font: press, align: center)
    }

    // ---- the panel ----
    rect(PX, PY, PW, PH, fill: surface, stroke: border, width: 2)
    rect(PX + 2, PY + 2, PW - 4, 2, fill: alpha(foreground, 0.06))
    if playing && sel >= 0 && selT < 0 {
      text("BUILD A TOWER", PX + 10, PY + 13, size: 8, color: muted, font: press)
      for k in range(4) {
        let cx = PX + 8 + k % CC * (CWd + 6)
        let cy = CY + floor(k / CC) * (CH + 6)
        let ok = gold >= KD[k].cost
        let ts = min((CH - 34) / 16, (CWd - 12) / 12)
        rect(cx, cy, CWd, CH, fill: ok ? alpha(foreground, 0.06) : alpha(foreground, 0.02), stroke: ok ? accent : border, width: 2)
        layer(ok ? 1 : 0.4) {
          translate(cx + CWd / 2 - 6 * ts, cy + 6) {
            scale(ts, ts, 0, 0) {
              for o in towerArt[k].o { path(o, closed: true, fill: PAL.o) }
              for r in towerArt[k].r { rect(r[0], r[1], r[2], r[3], fill: tierPal[0][r[4]]) }
            }
          }
          text(KD[k].n, cx + CWd / 2, cy + CH - 22, size: 6, color: foreground, font: press, align: center)
          text("${KD[k].cost}", cx + CWd / 2, cy + CH - 10, size: 8, color: yellow, font: press, align: center)
        }
      }
    } else if playing && selT >= 0 {
      let t = tw[selT]
      let tier = min(4, floor((t.l - 1) / 3))
      let ts = LS ? min((UY - PY - 20) / 18, 3, (PW - 100) / 12) : min((PH - 20) / 18, 4)
      translate(PX + 10, PY + 10) {
        scale(ts, ts, 0, 0) {
          for o in towerArt[t.k].o { path(o, closed: true, fill: PAL.o) }
          for r in towerArt[t.k].r { rect(r[0], r[1], r[2], r[3], fill: tierPal[tier][r[4]]) }
        }
      }
      let ix = PX + 20 + 12 * ts
      text(KD[t.k].n, ix, PY + 16, size: 9, color: foreground, font: press)
      text("LEVEL ${t.l}", ix, PY + 32, size: 8, color: tierGlow[tier], font: press)
      text("DMG ${fmtNum(t.dmg, {compact: t.dmg >= 10000})}", ix, PY + 50, size: 7, color: muted, font: press)
      text("RANGE ${fixed(t.r, 1)}", ix, PY + 64, size: 7, color: muted, font: press)
      text(t.k == 2 ? "SLOW ${round(t.slow * 100)}%" : t.k == 1 ? "SPLASH ${fixed(t.sp, 1)}" : t.k == 3 ? "CHAIN ${t.ch}" : "${fixed(1 / t.per, 1)}/S", ix, PY + 78, size: 7, color: muted, font: press)
      let can = gold >= t.up
      rect(BX, UY, BW, BH, fill: can ? green : alpha(foreground, 0.04), stroke: can ? green : border, width: 2)
      text("UPGRADE", BX + BW / 2, UY + BH / 2 - 7, size: 8, color: can ? background : muted, font: press, align: center)
      text("${fmtNum(t.up, {compact: t.up >= 100000})}", BX + BW / 2, UY + BH / 2 + 8, size: 8, color: can ? background : muted, font: press, align: center)
      rect(BX, SY, BW, BH, fill: alpha(red, 0.25), stroke: red, width: 2)
      text("SELL", BX + BW / 2, SY + BH / 2 - 7, size: 8, color: foreground, font: press, align: center)
      text("+${fmtNum(t.sell, {compact: t.sell >= 100000})}", BX + BW / 2, SY + BH / 2 + 8, size: 8, color: yellow, font: press, align: center)
    } else if playing {
      text(nextAt > 0 ? "WAVE ${wave + 1} IN ${max(0, ceil(nextAt - F0.t))}" : "WAVE ${wave}: ${len(F0.es)} LEFT", PX + PW / 2, PY + 22, size: 10, color: foreground, font: press, align: center)
      // who comes next
      let nw = wave + 1
      let kinds = nw % 10 == 0 ? [3, 1] : nw % 5 == 0 ? [1] : nw >= 7 ? [0, 2, 1] : nw >= 3 ? [0, 2] : [0]
      let ks = min(4, (PH - 110) / 18, PW / 80)
      text("NEXT", PX + PW / 2, PY + 44, size: 6, color: muted, font: press, align: center)
      for k, i in kinds {
        let sz = enemySize[k]
        translate(PX + PW / 2 + (i - (len(kinds) - 1) / 2) * 22 * ks - sz[0] * ks / 2, PY + 56 + (16 - sz[1]) * ks) {
          scale(ks, ks, 0, 0) {
            for o in enemyArt[k][floor(time * 3 + i) % 2].o { path(o, closed: true, fill: PAL.o) }
            for r in enemyArt[k][floor(time * 3 + i) % 2].r { rect(r[0], r[1], r[2], r[3], fill: PAL[r[4]]) }
          }
        }
      }
      text("TAP GRASS TO BUILD", PX + PW / 2, PY + PH - 48, size: 6, color: muted, font: press, align: center)
      text("TAP A TOWER TO UPGRADE", PX + PW / 2, PY + PH - 36, size: 6, color: muted, font: press, align: center)
      if best > 0 { text("BEST WAVE ${best}", PX + PW / 2, PY + PH - 16, size: 7, color: accent, font: press, align: center) }
    }

    // ---- title and game over ----
    if mode == "title" {
      rect(0, 0, SW, SH, fill: alpha(background, 0.7))
      let ty = FY + FHt * (LS ? 0.15 : 0.3)
      text("BASTION", SW / 2 + 3, ty + 3, size: 30, color: alpha("#000000", 0.5), font: press, align: center)
      text("BASTION", SW / 2, ty, size: 30, color: accent, font: press, align: center)
      text("ENDLESS TOWER DEFENSE", SW / 2, ty + 34, size: 8, color: foreground, font: press, align: center)
      for k in range(4) {
        translate(SW / 2 + (k - 1.5) * 64 - 18, ty + 64 + sin(time * 2 + k) * 3) {
          scale(3, 3, 0, 0) {
            for o in towerArt[k].o { path(o, closed: true, fill: PAL.o) }
            for r in towerArt[k].r { rect(r[0], r[1], r[2], r[3], fill: tierPal[k][r[4]]) }
          }
        }
      }
      if time % 1.2 < 0.8 { text("TAP TO START", SW / 2, ty + 150, size: 10, color: foreground, font: press, align: center) }
      if best > 0 { text("BEST WAVE ${best}", SW / 2, ty + 172, size: 8, color: accent, font: press, align: center) }
    } else if mode == "over" {
      rect(0, 0, SW, SH, fill: alpha(background, 0.75))
      let ty = FY + FHt * (LS ? 0.15 : 0.32)
      text("THE KEEP", SW / 2 + 2, ty + 2, size: 20, color: alpha("#000000", 0.5), font: press, align: center)
      text("THE KEEP", SW / 2, ty, size: 20, color: red, font: press, align: center)
      text("HAS FALLEN", SW / 2 + 2, ty + 30, size: 20, color: alpha("#000000", 0.5), font: press, align: center)
      text("HAS FALLEN", SW / 2, ty + 28, size: 20, color: red, font: press, align: center)
      text("YOU HELD ${wave} WAVES", SW / 2, ty + 66, size: 9, color: foreground, font: press, align: center)
      text("BEST ${best}", SW / 2, ty + 86, size: 9, color: accent, font: press, align: center)
      if (time - overT > 1.2 || time < overT) && time % 1.2 < 0.8 { text("TAP TO PLAY AGAIN", SW / 2, ty + 120, size: 9, color: foreground, font: press, align: center) }
    }
  }
}
